#include <stdio.h>

int isLeap(int year)
{
    return (year % 4 == 0 && year % 100 != 0) || (year % 400 == 0);
}

int main()
{
    int year, month, day, start, i;
    int days[12] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
    char *names[12] = {"January", "February", "March", "April",
                       "May", "June", "July", "August",
                       "September", "October", "November", "December"};

    printf("Enter year: ");
    scanf("%d", &year);

    if (isLeap(year))
        days[1] = 29;

    start = (1 + 5 * ((year - 1) % 4)
               + 4 * ((year - 1) % 100)
               + 6 * ((year - 1) % 400)) % 7;

    for (month = 0; month < 12; month++) {
        printf("\n   %s %d\n", names[month], year);
        printf("Su Mo Tu We Th Fr Sa\n");

        for (i = 0; i < start; i++)
            printf("   ");

        for (day = 1; day <= days[month]; day++) {
            printf("%2d ", day);
            if ((start + day) % 7 == 0)
                printf("\n");
        }
        printf("\n");
        start = (start + days[month]) % 7;
    }

    return 0;
}

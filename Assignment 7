#include <stdio.h>

struct student {
    int roll;
    char name[30];
    int marks[3];
    int total;
    float percentage;
    char result[10];
};
int main()
{
    struct student s[50];
    int n, i, j;

    printf("Enter number of students: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        printf("\nEnter details of student %d\n", i + 1);

        printf("Roll number: ");
        scanf("%d", &s[i].roll);

        printf("Name : ");
        scanf("%s", s[i].name);

        s[i].total = 0;
        for (j = 0; j < 3; j++) {
            printf("Marks in subject %d: ", j + 1);
            scanf("%d", &s[i].marks[j]);
            s[i].total = s[i].total + s[i].marks[j];
        }

        s[i].percentage = s[i].total / 3.0;

        /* Pass only if every subject has 35 or more */
        if (s[i].marks[0] >= 35 && s[i].marks[1] >= 35 && s[i].marks[2] >= 35) {
            s[i].result[0] = 'P'; s[i].result[1] = 'a';
            s[i].result[2] = 's'; s[i].result[3] = 's';
            s[i].result[4] = '\0';
        } else {
            s[i].result[0] = 'F'; s[i].result[1] = 'a';
            s[i].result[2] = 'i'; s[i].result[3] = 'l';
            s[i].result[4] = '\0';
        }
    }

    printf("\n======== STUDENT RESULTS ========\n");
    printf("Roll\tName\t\tTotal\tPercent\tResult\n");
    for (i = 0; i < n; i++) {
        printf("%d\t%-10s\t%d\t%.2f\t%s\n",
               s[i].roll, s[i].name, s[i].total,
               s[i].percentage, s[i].result);
    }

    return 0;
}

#include <stdio.h>

int main()
{
    char str1[100], str2[100], temp[200];
    int choice, i, j, len;

    printf("Enter first string: ");
    scanf("%s", str1);
    printf("Enter second string: ");
    scanf("%s", str2);

    do {
        printf("\n===== STRING MENU =====\n");
        printf("1. Length\n");
        printf("2. Copy\n");
        printf("3. Concatenate\n");
        printf("4. Compare\n");
        printf("5. Reverse\n");
        printf("6. Uppercase\n");
        printf("7. Lowercase\n");
        printf("8. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                len = 0;
                while (str1[len] != '\0')
                    len++;
                printf("Length = %d\n", len);
                break;

            case 2:
                for (i = 0; str1[i] != '\0'; i++)
                    temp[i] = str1[i];
                temp[i] = '\0';
                printf("Copied string = %s\n", temp);
                break;

            case 3:
                for (i = 0; str1[i] != '\0'; i++)
                    temp[i] = str1[i];
                for (j = 0; str2[j] != '\0'; j++)
                    temp[i + j] = str2[j];
                temp[i + j] = '\0';
                printf("Concatenated string = %s\n", temp);
                break;

            case 4:
                i = 0;
                while (str1[i] != '\0' && str1[i] == str2[i])
                    i++;
                if (str1[i] == str2[i])
                    printf("Strings are equal\n");
                else
                    printf("Strings are not equal\n");
                break;

            case 5:
                len = 0;
                while (str1[len] != '\0')
                    len++;
                for (i = 0; i < len; i++)
                    temp[i] = str1[len - 1 - i];
                temp[len] = '\0';
                printf("Reversed string = %s\n", temp);
                break;

            case 6:
                for (i = 0; str1[i] != '\0'; i++) {
                    if (str1[i] >= 'a' && str1[i] <= 'z')
                        temp[i] = str1[i] - 32;
                    else
                        temp[i] = str1[i];
                }
                temp[i] = '\0';
                printf("Uppercase = %s\n", temp);
                break;

            case 7:
                for (i = 0; str1[i] != '\0'; i++) {
                    if (str1[i] >= 'A' && str1[i] <= 'Z')
                        temp[i] = str1[i] + 32;
                    else
                        temp[i] = str1[i];
                }
                temp[i] = '\0';
                printf("Lowercase = %s\n", temp);
                break;

            case 8:
                printf("Exiting program.\n");
                break;

            default:
                printf("Invalid choice\n");
        }
    } while (choice != 8);

    return 0;
}
